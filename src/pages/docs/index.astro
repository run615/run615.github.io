---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const docs = await getCollection('docs');
const categories = [...new Set(docs.map(d => d.data.category || '其他'))];
const grouped = Object.fromEntries(
  categories.map(cat => [
    cat,
    docs.filter(d => (d.data.category || '其他') === cat).sort((a, b) => (a.data.order || 0) - (b.data.order || 0)),
  ])
);
---

<BaseLayout title="文档 - run615">
  <section class="page">
    <div class="container">
      <h1 class="page-title">文档</h1>
      <p class="page-subtitle">OpenCode 官方文档中文参考</p>

      {Object.entries(grouped).map(([cat, items]) => (
        <div class="doc-section">
          <h2 class="section-title">{cat}</h2>
          <div class="doc-list">
            {items.map(doc => (
              <a href={`/docs/${doc.id}`} class="card doc-card">
                <h3 class="doc-title">{doc.data.title}</h3>
                <p class="doc-desc">{doc.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .doc-section {
    margin-bottom: 40px;
  }

  .doc-list {
    display: grid;
    gap: 10px;
  }

  .doc-card {
    display: block;
    color: var(--text) !important;
    padding: 16px 20px;
  }

  .doc-title {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .doc-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
