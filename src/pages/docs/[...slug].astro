---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map(e => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description } = entry.data;
const slug = entry.id;

const allDocs = await getCollection('docs');
const categories = [...new Set(allDocs.map(d => d.data.category || '其他'))];
const grouped = Object.fromEntries(
  categories.map(cat => [
    cat,
    allDocs.filter(d => (d.data.category || '其他') === cat)
      .sort((a, b) => (a.data.order || 0) - (b.data.order || 0)),
  ])
);

const categoryOrder = ['OpenCode 开发手册', '好文收藏'];
const sortedCategories = categories.sort(
  (a, b) => (categoryOrder.indexOf(a) !== -1 ? categoryOrder.indexOf(a) : 99) -
    (categoryOrder.indexOf(b) !== -1 ? categoryOrder.indexOf(b) : 99)
);
---

<BaseLayout title={`${title} - 文档`}>
  <div class="docs-layout" data-theme="light" id="docs-layout-root">
    <aside class="docs-sidebar">
      <nav class="sidebar-nav">
        <a href="/docs" class="sidebar-back">← 所有文档</a>
        {sortedCategories.map(cat => {
          const hasActive = grouped[cat].some(doc => doc.id === slug);
          return (
            <details class="sidebar-group" open={hasActive}>
              <summary class="sidebar-group-title">{cat}</summary>
              <ul class="sidebar-links">
                {grouped[cat].map(doc => (
                  <li>
                    <a
                      href={`/docs/${doc.id}`}
                      class:list={{ 'sidebar-link': true, active: doc.id === slug }}
                    >
                      {doc.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          );
        })}
      </nav>
    </aside>

    <main class="docs-main">
      <article class="doc-content">
        <h1 class="doc-title">{title}</h1>
        {description && <p class="doc-desc">{description}</p>}
        <div class="sl-markdown-content">
          <Content />
        </div>
      </article>
    </main>

    {headings.length > 0 && (
      <aside class="docs-toc">
        <nav>
          <h3 class="toc-title">本页内容</h3>
          <ul class="toc-list">
            {headings.filter(h => h.depth <= 4).map(h => (
              <li class={`toc-h${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
  <script>
    document.documentElement.dataset.theme = 'light';
  </script>
</BaseLayout>

<link rel="stylesheet" href="/docs/_astro/starlight.css">
<link rel="stylesheet" href="/docs/_astro/ec.css">
<style>
  .docs-layout {
    /* Starlight light theme (matches opencode.ai) */
    --sl-hue-blue: 234;
    --sl-hue-purple: 281;
    --sl-hue-orange: 41;
    --sl-hue-red: 339;
    --sl-color-white: hsl(224, 10%, 10%);
    --sl-color-gray-1: hsl(224, 14%, 16%);
    --sl-color-gray-2: hsl(224, 10%, 23%);
    --sl-color-gray-3: hsl(224, 7%, 36%);
    --sl-color-gray-4: hsl(224, 6%, 56%);
    --sl-color-gray-5: hsl(224, 6%, 77%);
    --sl-color-gray-6: hsl(224, 20%, 94%);
    --sl-color-gray-7: hsl(224, 19%, 97%);
    --sl-color-black: hsl(0, 0%, 100%);
    --sl-color-blue-high: hsl(var(--sl-hue-blue), 80%, 30%);
    --sl-color-blue: hsl(var(--sl-hue-blue), 90%, 60%);
    --sl-color-blue-low: hsl(var(--sl-hue-blue), 88%, 90%);
    --sl-color-purple-high: hsl(var(--sl-hue-purple), 90%, 30%);
    --sl-color-purple: hsl(var(--sl-hue-purple), 90%, 60%);
    --sl-color-purple-low: hsl(var(--sl-hue-purple), 80%, 90%);
    --sl-color-orange-high: hsl(var(--sl-hue-orange), 80%, 25%);
    --sl-color-orange: hsl(var(--sl-hue-orange), 90%, 60%);
    --sl-color-orange-low: hsl(var(--sl-hue-orange), 90%, 88%);
    --sl-color-red-high: hsl(var(--sl-hue-red), 80%, 30%);
    --sl-color-red: hsl(var(--sl-hue-red), 90%, 60%);
    --sl-color-red-low: hsl(var(--sl-hue-red), 80%, 90%);
    --sl-color-accent-high: hsl(234, 80%, 30%);
    --sl-color-accent: hsl(234, 90%, 60%);
    --sl-color-accent-low: hsl(234, 88%, 90%);
    --sl-color-text: hsl(224, 10%, 10%);
    --sl-color-text-accent: var(--sl-color-accent);
    --sl-color-text-invert: var(--sl-color-black);
    --sl-color-bg: hsl(0, 0%, 100%);
    --sl-color-bg-nav: var(--sl-color-gray-7);
    --sl-color-bg-sidebar: var(--sl-color-bg);
    --sl-color-bg-inline-code: var(--sl-color-gray-6);
    --sl-color-bg-accent: var(--sl-color-accent);
    --sl-color-border: var(--sl-color-gray-5);
    --sl-color-hairline: var(--sl-color-gray-6);
    --sl-color-hairline-light: var(--sl-color-gray-6);
    --sl-color-hairline-shade: var(--sl-color-gray-6);
    --sl-text-code-sm: 0.8125rem;
    --sl-text-code: 0.875rem;
    --sl-text-h5: 1.125rem;
    --sl-line-height-headings: 1.2;
    --sl-font-system-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    --sl-font-system-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji';
    --sl-font-mono: var(--sl-font-system-mono);
    --sl-font: var(--sl-font-system-sans);
    --sl-text-h1: 2.5rem;
    --sl-text-h2: 2rem;
    --sl-text-h3: 1.5625rem;
    --sl-text-h4: 1.25rem;
    --sl-text-base: 1rem;
    --sl-text-sm: .875rem;
    --sl-text-xs: .8125rem;
    --sl-line-height: 1.6875;
    --sl-nav-height: 3.5rem;
    --sl-nav-pad-x: 1rem;
    --sl-nav-pad-y: .75rem;
    --sl-sidebar-width: 18.25rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    /* Map old variable names */
    --bg-secondary: var(--sl-color-gray-6);
    --bg-tertiary: var(--sl-color-gray-5);
    --text: var(--sl-color-text);
    --text-secondary: var(--sl-color-gray-2);
    --text-tertiary: var(--sl-color-gray-3);
    --accent: var(--sl-color-accent);
    --accent-hover: var(--sl-color-accent-high);
    --border: var(--sl-color-border);
    --font-mono: var(--sl-font-mono);
    --font-sans: var(--sl-font);
  }

  .docs-layout {
    display: flex;
    max-width: 1200px;
    margin: 0 auto;
    padding-top: calc(var(--nav-height) + 40px);
    padding-bottom: 80px;
    min-height: 100vh;
  }

  /* ── Sidebar ── */
  .docs-sidebar {
    width: 240px;
    flex-shrink: 0;
    padding: 0 20px;
    position: sticky;
    top: calc(var(--nav-height) + 40px);
    align-self: flex-start;
    max-height: calc(100vh - var(--nav-height) - 80px);
    overflow-y: auto;
  }

  .sidebar-back {
    display: block;
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .sidebar-back:hover {
    color: var(--accent);
  }

  .sidebar-group {
    margin-bottom: 4px;
  }

  .sidebar-group-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 8px;
    border-radius: 6px;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .sidebar-group-title::-webkit-details-marker {
    display: none;
  }

  .sidebar-group-title::before {
    content: '▶';
    font-size: 8px;
    transition: transform 0.2s;
  }

  .sidebar-group[open] > .sidebar-group-title::before {
    transform: rotate(90deg);
  }

  .sidebar-group-title:hover {
    background: var(--bg-secondary);
  }

  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-links li {
    margin: 0;
  }

  .sidebar-link {
    display: block;
    padding: 6px 8px;
    font-size: 13px;
    color: var(--text-secondary);
    border-radius: 6px;
    transition: all 0.15s;
    line-height: 1.4;
  }

  .sidebar-link:hover {
    color: var(--text);
    background: var(--bg-secondary);
  }

  .sidebar-link.active {
    color: var(--accent);
    background: rgba(0, 113, 227, 0.08);
    font-weight: 500;
  }

  /* ── Main Content ── */
  .docs-main {
    flex: 1;
    min-width: 0;
    padding: 0 40px;
  }

  .doc-title {
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 8px;
  }

  .doc-desc {
    font-size: 17px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .doc-content {
    font-size: 16px;
    line-height: 1.75;
    color: var(--text);
  }

  .doc-content :global(h2) {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 40px 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .doc-content :global(h3) {
    font-size: 19px;
    font-weight: 600;
    margin: 32px 0 12px;
  }

  .doc-content :global(h4) {
    font-size: 16px;
    font-weight: 600;
    margin: 24px 0 8px;
    color: var(--text);
  }

  .doc-content :global(h4:first-of-type) {
    margin-top: 0;
  }

  .doc-content :global(hr + h4) {
    margin-top: 8px;
  }

  .doc-content :global(p) {
    margin-bottom: 16px;
  }

  .doc-content :global(ul), .doc-content :global(ol) {
    margin: 12px 0 20px;
    padding-left: 24px;
  }

  .doc-content :global(li) {
    margin-bottom: 6px;
  }

  .doc-content :global(li > ul), .doc-content :global(li > ol) {
    margin: 4px 0;
  }

  .doc-content :global(strong) {
    font-weight: 600;
  }

  .doc-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .doc-content :global(a:hover) {
    color: var(--accent-hover);
  }

  /* ── Inline code ── */
  .doc-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--bg-secondary);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--text);
  }

  /* ── Code blocks ── */
  .doc-content :global(> pre) {
    margin: 20px 0;
    padding: 16px 20px;
    background: var(--sl-color-gray-6);
    border-radius: 8px;
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.7;
  }

  .doc-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
    color: var(--sl-color-text);
    tab-size: 2;
  }

  .doc-content :global(pre code .line) {
    display: block;
  }

  /* ── Tables ── */
  .doc-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    font-size: 14px;
    overflow-x: auto;
    display: block;
  }

  .doc-content :global(th), .doc-content :global(td) {
    padding: 10px 14px;
    border: 1px solid var(--border);
    text-align: left;
  }

  .doc-content :global(th) {
    background: var(--bg-secondary);
    font-weight: 600;
    font-size: 13px;
  }

  .doc-content :global(tr:nth-child(even)) {
    background: var(--bg-secondary);
  }

  /* ── Horizontal rule ── */
  .doc-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 32px 0;
  }

  /* ── TOC ── */
  .docs-toc {
    width: 200px;
    flex-shrink: 0;
    padding: 0 16px;
    position: sticky;
    top: calc(var(--nav-height) + 40px);
    align-self: flex-start;
  }

  .toc-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--border);
  }

  .toc-list li {
    margin: 0;
  }

  .toc-list a {
    display: block;
    padding: 4px 12px;
    font-size: 12px;
    color: var(--text-tertiary);
    line-height: 1.4;
    border-left: 1px solid transparent;
    margin-left: -1px;
    transition: all 0.15s;
  }

  .toc-list a:hover {
    color: var(--text);
    border-left-color: var(--text);
  }

  .toc-h3 a {
    padding-left: 24px;
    font-size: 11px;
  }

  .toc-list a.current {
    color: var(--sl-color-accent);
    border-left-color: var(--sl-color-accent);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .docs-toc {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .docs-layout {
      flex-direction: column;
      padding-top: calc(var(--nav-height) + 20px);
    }

    .docs-sidebar {
      width: 100%;
      position: static;
      max-height: none;
      padding: 0 22px 20px;
      margin-bottom: 0;
      border-bottom: 1px solid var(--border);
      overflow: visible;
    }

    .sidebar-groups {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    details.sidebar-group {
      margin-bottom: 0;
    }

    details.sidebar-group[open] > summary.sidebar-group-title {
      margin-bottom: 8px;
    }

    .sidebar-group-title {
      font-size: 10px;
      padding: 4px 8px;
    }

    .sidebar-group-title::before {
      display: none;
    }

    .sidebar-links {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
    }

    .sidebar-link {
      padding: 4px 10px;
      font-size: 12px;
      border-radius: 100px;
      background: var(--bg-secondary);
    }

    .sidebar-link.active {
      background: var(--accent);
      color: white;
    }

    .sidebar-back {
      display: none;
    }

    .docs-main {
      padding: 0 22px;
    }

    .doc-title {
      font-size: 28px;
    }
  }
</style>
