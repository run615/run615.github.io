---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'astro-website',
    desc: '基于 Astro 构建的个人博客与作品集，支持 Markdown 内容管理和响应式设计。',
    lang: 'TypeScript',
    url: 'https://github.com/run615/run615.github.io',
  },
  {
    title: 'react-components',
    desc: '一套现代化的 React 组件库，内置 30+ 高质量组件。支持 TypeScript 和主题定制。',
    lang: 'TypeScript',
    url: 'https://github.com/run615/react-components',
  },
  {
    title: 'go-micro-service',
    desc: '使用 Go 语言构建的微服务框架，集成 gRPC 通信和分布式追踪。',
    lang: 'Go',
    url: 'https://github.com/run615/go-micro-service',
  },
  {
    title: 'vue-admin-dashboard',
    desc: '基于 Vue 3 的管理后台模板，内置权限管理和数据可视化功能。',
    lang: 'Vue',
    url: 'https://github.com/run615/vue-admin-dashboard',
  },
  {
    title: 'python-data-tools',
    desc: '数据分析和处理工具集，包含数据清洗、特征工程等功能模块。',
    lang: 'Python',
    url: 'https://github.com/run615/python-data-tools',
  },
  {
    title: 'docker-dev-env',
    desc: '一站式开发环境配置，支持多种语言和框架的一键启动。',
    lang: 'Dockerfile',
    url: 'https://github.com/run615/docker-dev-env',
  },
];
---

<BaseLayout title="项目 - run615">
  <section class="page">
    <div class="container">
      <h1 class="page-title">项目</h1>
      <p class="page-subtitle">我参与和创建的开源项目</p>

      <div class="projects-grid">
        {projects.map(p => (
          <a href={p.url} target="_blank" rel="noopener noreferrer" class="card project-card">
            <p class="project-lang">{p.lang}</p>
            <h2 class="project-title">{p.title}</h2>
            <p class="project-desc">{p.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .project-card {
    color: var(--text) !important;
  }

  .project-lang {
    font-size: 11px;
    color: var(--accent);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }

  .project-title {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }

  .project-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 734px) {
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
