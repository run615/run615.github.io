---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于 - run615">
  <section class="page">
    <div class="container">
      <h1 class="page-title">关于</h1>

      <div class="about-section">
        <p class="about-text">
          你好，我是 run615，一名全栈开发者。我热衷于构建优雅、高性能的数字产品，
          并积极参与开源社区。
        </p>
      </div>

      <div class="about-section">
        <h2 class="section-title">技术栈</h2>
        <div class="tags">
          <span class="tag">TypeScript</span>
          <span class="tag">React</span>
          <span class="tag">Vue</span>
          <span class="tag">Node.js</span>
          <span class="tag">Python</span>
          <span class="tag">Go</span>
          <span class="tag">Docker</span>
          <span class="tag">PostgreSQL</span>
          <span class="tag">Redis</span>
          <span class="tag">GraphQL</span>
          <span class="tag">Kubernetes</span>
          <span class="tag">AWS</span>
        </div>
      </div>

      <div class="about-section">
        <h2 class="section-title">联系方式</h2>
        <div class="contact-grid">
          <a href="https://github.com/run615" target="_blank" rel="noopener noreferrer" class="card contact-card">
            <p class="contact-label">GitHub</p>
            <p class="contact-value">@run615</p>
          </a>
          <a href="mailto:run615@example.com" class="card contact-card">
            <p class="contact-label">Email</p>
            <p class="contact-value">run615@example.com</p>
          </a>
          <div class="card contact-card">
            <p class="contact-label">位置</p>
            <p class="contact-value">中国</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-section {
    margin-bottom: 48px;
  }

  .about-text {
    font-size: 19px;
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .contact-card {
    text-align: center;
    color: var(--text) !important;
  }

  .contact-label {
    font-size: 13px;
    color: var(--text-tertiary);
    margin-bottom: 4px;
  }

  .contact-value {
    font-size: 15px;
    font-weight: 500;
  }

  @media (max-width: 734px) {
    .contact-grid { grid-template-columns: 1fr; }
    .about-text { font-size: 17px; }
  }
</style>
