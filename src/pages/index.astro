---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = [
  'TypeScript', 'React', 'Vue', 'Node.js', 'Python',
  'Go', 'Docker', 'PostgreSQL', 'Redis', 'GraphQL',
];

const projects = [
  {
    title: 'astro-website',
    desc: '基于 Astro 构建的个人博客与作品集',
    lang: 'TypeScript',
  },
  {
    title: 'react-components',
    desc: '现代化的 React 组件库',
    lang: 'TypeScript',
  },
  {
    title: 'go-micro-service',
    desc: '使用 Go 构建的微服务框架',
    lang: 'Go',
  },
];
---

<BaseLayout title="run615" description="全栈开发者 · 开源爱好者">
  <section class="hero">
    <div class="container">
      <h1 class="hero-title">
        你好，我是<br />
        <span class="hero-name">run615</span>
      </h1>
      <p class="hero-subtitle">全栈开发者</p>
      <p class="hero-desc">
        热衷于构建优雅、高性能的数字产品
      </p>
      <div class="hero-actions">
        <a href="/projects" class="btn-primary">查看项目</a>
        <a href="/about" class="btn-secondary">关于我</a>
      </div>
    </div>
  </section>

  <section class="skills">
    <div class="container">
      <div class="skills-inner">
        {skills.map(skill => (
          <span class="skill-tag">{skill}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="featured">
    <div class="container">
      <h2 class="section-title">精选项目</h2>
      <div class="featured-grid">
        {projects.map(p => (
          <a href="/projects" class="card featured-card">
            <p class="featured-lang">{p.lang}</p>
            <h3 class="featured-title">{p.title}</h3>
            <p class="featured-desc">{p.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <div class="cta-card">
        <h2 class="cta-title">保持联系</h2>
        <p class="cta-desc">如果你有兴趣合作，或者只是想打个招呼，随时联系我。</p>
        <div class="cta-actions">
          <a href="https://github.com/run615" target="_blank" class="btn-primary" rel="noopener noreferrer">GitHub</a>
          <a href="mailto:run615@example.com" class="btn-secondary">发送邮件</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 160px 0 80px;
    text-align: center;
  }

  .hero-title {
    font-size: 56px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 8px;
  }

  .hero-name {
    display: inline-block;
    background: linear-gradient(135deg, #1a1a1a, #555555);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 24px;
    font-weight: 400;
    color: var(--text-secondary);
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }

  .hero-desc {
    font-size: 17px;
    color: var(--text-tertiary);
    margin-bottom: 32px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border-radius: 980px;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--accent);
    color: white !important;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .btn-secondary {
    background: var(--bg-secondary);
    color: var(--text) !important;
  }

  .btn-secondary:hover {
    background: var(--bg-tertiary);
  }

  .skills {
    padding: 40px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--bg-secondary);
  }

  .skills-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .skill-tag {
    padding: 6px 14px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 13px;
    color: var(--text-secondary);
    font-weight: 500;
    transition: all 0.2s;
  }

  .skill-tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .featured {
    padding: 80px 0;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .featured-card {
    color: var(--text) !important;
  }

  .featured-lang {
    font-size: 11px;
    color: var(--accent);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .featured-title {
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }

  .featured-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .cta {
    padding: 0 0 80px;
  }

  .cta-card {
    text-align: center;
    padding: 64px 32px;
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
  }

  .cta-title {
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .cta-desc {
    font-size: 17px;
    color: var(--text-secondary);
    margin-bottom: 28px;
  }

  .cta-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  @media (max-width: 734px) {
    .hero { padding: 120px 0 60px; }
    .hero-title { font-size: 36px; }
    .hero-subtitle { font-size: 20px; }
    .featured-grid { grid-template-columns: 1fr; }
    .cta-title { font-size: 28px; }
    .cta-card { padding: 40px 24px; }
  }
</style>
